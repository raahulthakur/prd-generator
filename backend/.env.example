# LLM provider: "anthropic" (default) or "openrouter"
LLM_PROVIDER=openrouter

# Required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default model for the selected provider
# Anthropic default: claude-opus-4-6
# OpenRouter default: anthropic/claude-opus-4
# LLM_MODEL=
